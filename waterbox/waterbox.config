      "P4 Select",
      "P4 Start",
      "P4 Up",
      "P4 Down",
      "P4 Left",
      "P4 Right",
      "P2 Trigger",
      "P2 Fire",
      "Expansion Trigger",
      "Expansion Fire",
      "Previous Disk",
      "Next Disk",
      "Eject Disk"
    ],
