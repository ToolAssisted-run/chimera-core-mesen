{
  "coreName": "Mesen",
  "systemId": "NES",
  "systemNames": {
    "NES": "Nintendo Entertainment System",
    "SNES": "Super NES / Super Famicom",
    "SGB": "Super Game Boy",
    "GB": "Game Boy",
    "GBC": "Game Boy Color"
  },
  "author": "Sour and the MesenCE contributors; Chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-mesen",
  "romFile": "rom",
  "deterministic": true,
  "suggestSettings": true,
  "memoryLayoutMiB": [
    64,
    4,
    4,
    4,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. Mesen's library and an NES game fit with room; waterbox/run-wbx.c uses the same layout.",
  "video": {
    "_comment": "buffer capacity; the live size comes from GetVideoWidth/Height (256x240; 512x240 for a VS DualSystem game showing both screens)",
    "width": 512,
    "height": 240,
    "virtualWidth": 293,
    "virtualHeight": 240,
    "vsyncNumerator": 39375000,
    "vsyncDenominator": 655171,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 2048,
    "channels": 2,
    "rate": 48000,
    "get": "GetAudio"
  },
  "input": {
    "name": "NES Controller",
    "picture": "pictures/nes-controller.png",
    "_comment": "index order is the wire: Power and Reset (the console's), then pads 1 to 4 in quickerNES's order (3 and 4 through the Four Score or the Famicom's four-player adapter), then P2 Trigger (the Zapper's) and P2 Fire (the Arkanoid controller's), then Expansion Trigger and Expansion Fire (the same two devices on the Famicom's expansion port), then Previous Disk, Next Disk and Eject Disk (the Famicom Disk System's drive: Previous and Next move a selector over the disk's sides, Eject Disk takes the disk out while it is held and puts the selected side in when it is let go). Axes: P2 Zapper X and Y (0..65535 across the picture), P2 Paddle (the knob, 0..160, as quickerNES's), then Expansion Zapper X and Y and Expansion Paddle. The expansion port's and the drive's controls are the console's group (in no player's list), since the port is the console's. The declaration is the union of what the ports can hold; IsButtonActive and IsAxisActive say what this machine has. The order only grows, so a movie made before keeps its columns.",
    "buttons": [
      "Power",
      "Reset",
      "P1 A",
      "P1 B",
      "P1 Select",
      "P1 Start",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P2 A",
      "P2 B",
      "P2 Select",
      "P2 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P3 A",
      "P3 B",
      "P3 Select",
      "P3 Start",
