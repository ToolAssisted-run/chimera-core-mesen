{
  "coreName": "Mesen",
  "systemId": "NES",
  "systemNames": {
    "NES": "Nintendo Entertainment System"
  },
  "author": "Sour and the MesenCE contributors; Chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-mesen",
  "romFile": "rom",
  "deterministic": true,
  "suggestSettings": true,
  "memoryLayoutMiB": [
    64,
    4,
    4,
    4,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. Mesen's library and an NES game fit with room; waterbox/run-wbx.c uses the same layout.",
  "video": {
    "_comment": "buffer capacity; the live size comes from GetVideoWidth/Height (256x240; 512x240 for a VS DualSystem game showing both screens)",
    "width": 512,
    "height": 240,
    "virtualWidth": 293,
    "virtualHeight": 240,
    "vsyncNumerator": 39375000,
    "vsyncDenominator": 655171,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 2048,
    "channels": 2,
    "rate": 48000,
    "get": "GetAudio"
  },
  "input": {
    "name": "NES Controller",
    "picture": "pictures/nes-controller.png",
    "_comment": "index order is the wire: Power and Reset (the console's), then pad 1 and pad 2 in quickerNES's order",
    "buttons": [
      "Power",
      "Reset",
      "P1 A",
      "P1 B",
      "P1 Select",
      "P1 Start",
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P2 A",
      "P2 B",
      "P2 Select",
      "P2 Start",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right"
    ],
    "mnemonics": {
      "Power": "P",
      "Reset": "r",
      "A": "A",
      "B": "B",
      "Select": "s",
      "Start": "S",
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R"
    },
    "players": [
      [
        "P1 A",
        "P1 B",
        "P1 Select",
        "P1 Start",
        "P1 Up",
        "P1 Down",
        "P1 Left",
        "P1 Right"
      ],
      [
        "P2 A",
        "P2 B",
        "P2 Select",
        "P2 Start",
        "P2 Up",
        "P2 Down",
        "P2 Left",
        "P2 Right"
      ]
    ]
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".nes": "NES",
    ".unf": "NES",
    ".unif": "NES"
  },
  "settings": [
    {
      "name": "region",
      "display": "setting.region",
      "description": "setting.region.about",
      "type": "enum",
      "options": [
        "auto",
        "ntsc",
        "pal",
        "dendy"
      ],
      "optionLabels": [
        "setting.region.auto",
        "setting.region.ntsc",
        "setting.region.pal",
        "setting.region.dendy"
      ],
      "default": "auto"
    },
    {
      "name": "port1",
      "display": "setting.port1",
      "description": "setting.port1.about",
      "type": "enum",
      "options": [
        "gamepad",
        "none"
      ],
      "optionLabels": [
        "setting.port.gamepad",
        "setting.port.none"
      ],
      "default": "gamepad"
    },
    {
      "name": "port2",
      "display": "setting.port2",
      "description": "setting.port2.about",
      "type": "enum",
      "options": [
        "none",
        "gamepad"
      ],
      "optionLabels": [
        "setting.port.none",
        "setting.port.gamepad"
      ],
      "default": "none"
    },
    {
      "name": "ramPowerOnState",
      "display": "setting.ram",
      "description": "setting.ram.about",
      "type": "enum",
      "options": [
        "zeros",
        "ones",
        "random"
      ],
      "optionLabels": [
        "setting.ram.zeros",
        "setting.ram.ones",
        "setting.ram.random"
      ],
      "default": "zeros"
    },
    {
      "name": "randomSeed",
      "display": "setting.seed",
      "description": "setting.seed.about",
      "type": "uint",
      "min": 0,
      "max": 4294967295,
      "default": 0
    },
    {
      "name": "epsmDrums",
      "display": "setting.epsm_drums",
      "description": "setting.epsm_drums.about",
      "type": "enum",
      "options": [
        "off",
        "on"
      ],
      "optionLabels": [
        "setting.off",
        "setting.on"
      ],
      "default": "off"
    }
  ],
  "firmware": [
    {
      "id": "ymf288_adpcm_rom.bin",
      "display": "firmware.ymf288",
      "description": "firmware.ymf288.about",
      "name": "ymf288_adpcm_rom.bin",
      "size": 8192,
      "nameHints": [
        "adpcm",
        "2608",
        "288",
        "rhythm"
      ],
      "requiredWhen": {
        "setting": "epsmDrums",
        "is": "on"
      }
    }
  ]
}
