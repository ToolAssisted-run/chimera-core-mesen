--- a/Utilities/RandomHelper.h
+++ b/Utilities/RandomHelper.h
@@ -2,13 +2,40 @@
 #include "pch.h"
 #include <random>
 
+#ifdef MESEN_FIXED_RANDOM
+//A host that must reproduce a run gives the emulator a sequence of its own in
+//place of std::random_device (which reads the processor's RDRAND). The state
+//is a plain global, so it is part of whatever holds the emulator's memory.
+//MesenFixedRandom::Seed() starts the sequence again from a host-chosen seed.
+class MesenFixedRandom
+{
+public:
+	typedef uint32_t result_type;
+	static constexpr result_type min() { return 0; }
+	static constexpr result_type max() { return 0xFFFFFFFFu; }
+	static uint64_t& State() { static uint64_t state = 0x853C49E6748FEA9Bull; return state; }
+	static void Seed(uint64_t seed) { State() = seed * 6364136223846793005ull + 0x853C49E6748FEA9Bull; }
+	result_type operator()()
+	{
+		//splitmix64
+		uint64_t z = (State() += 0x9E3779B97F4A7C15ull);
+		z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+		z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+		return (result_type)((z ^ (z >> 31)) >> 32);
+	}
+};
+#define MESEN_RANDOM_DEVICE MesenFixedRandom
+#else
+#define MESEN_RANDOM_DEVICE std::random_device
+#endif
+
 class RandomHelper
 {
 public:
 	template<typename T>
 	static T GetValue(T min, T max)
 	{
-		std::random_device rd;
+		MESEN_RANDOM_DEVICE rd;
 		std::mt19937 mt(rd());
 		std::uniform_int_distribution<> dist(min, max);
 		return dist(mt);
