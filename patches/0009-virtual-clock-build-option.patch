+extern int64_t MesenVirtualClockMs;
+#define MESEN_CLOCK_MS() (MesenVirtualClockMs)
+#else
+#define MESEN_CLOCK_MS() (std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count())
+#endif
+
