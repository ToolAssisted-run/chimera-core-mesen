+#ifdef MESEN_CLOCK_START
+//With no saved clock, the clock shows the host's time of day (a project's
+//Clock Start), not 2000-01-01 00:00:00: the year's last two digits, as the
+//chip holds them, the hour in the chip's 12 or 24 hour mode, and the day of
+//the week counted as Mesen counts it, 0 on 2000-01-01, so that the default
+//date gives the clock it gave before.
+void S3511ARtc::StartAt(int64_t ms)
+{
+	MesenClockDate d = MesenClockDateOf(ms);
+	auto bcd = [](int v) { return (uint8_t)(((v / 10) << 4) | (v % 10)); };
+
+	_state.Year = bcd((d.Year % 100 + 100) % 100);
+	_state.Month = bcd(d.Month);
+	_state.Day = bcd(d.Day);
+	_state.DoW = (uint8_t)(((d.Days - 10957) % 7 + 7) % 7);
+	_state.Minute = bcd(d.Minute);
+	_state.Second = bcd(d.Second);
+
+	bool is24hMode = _state.Status & 0x40;
+	int hour = is24hMode || d.Hour < 12 ? d.Hour : d.Hour - 12;
+	_state.Hour = bcd(hour) | (d.Hour >= 12 ? 0x80 : 0);
+}
+#endif
